# Copie este archivo como .env (en la raíz del repositorio) y complete los valores.
# El archivo .env NO se sube a GitHub.

# Clave para firmar los tokens JWT. Genere una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=reemplace-por-una-clave-larga-y-aleatoria

# Clave de prueba para los usuarios ficticios que crea seed.py (elija la que quiera).
DEMO_PASSWORD=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Opcional. Si se omite, se usa SQLite en backend/mesa_soporte.db
# Para otro motor, por ejemplo PostgreSQL (requiere instalar psycopg):
# DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/mesa_soporte

# Opcional. Solo hace falta si el frontend se sirve desde otro origen.
# CORS_ORIGINS=http://localhost:5500